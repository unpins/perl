perl-cross on a Mach-O build host (the x86_64-darwin -> aarch64-darwin cross).

perl-cross has no darwin support and assumes an ELF build host: it reads type
sizes with `readelf --syms` and byte order with `objdump`, and dies when
either is missing. A Mach-O object can't be read by them anyway. Applied on
top of perl-cross's tree (nixpkgs copies it into perl's source in postUnpack);
the Linux crosses keep the readelf path, their build host being ELF.

- cnf/configure_tool.sh: readelf/objdump not fatal (nothing calls them after
  this); `*darwin*` in the OS guesser, without which osname is empty and
  cnf/hints/darwin is never picked; darwin shared-object names and link flags,
  which perl-cross defines to ELF values before any hint runs (`-Wl,-E`, which
  Apple ld rejects).
- cnf/configure_type.sh: sizeof by compile-only bisection
  (`int p[(sizeof(T)==K)?1:-1];`), correct for both passes and both arches.
- cnf/configure_type_sel.sh: byte order from __BYTE_ORDER__, which the cross
  compiler already gives for the target.
- cnf/configure_misc.sh: dlext `bundle`, not `so`.
- Makefile: the final perl link exports its symbols with `-export_dynamic`
  rather than GNU `-Wl,-E`, so XS bundles still resolve against it.
- cnf/hints/darwin (new): the values perl-cross can't probe without running a
  target binary, as cnf/hints/linux does for Linux. Without them config_h.SH
  emits malformed `#  HAS_FOO` lines (first death: HAS_NANOSLEEP).

--- a/cnf/configure_misc.sh
+++ b/cnf/configure_misc.sh
@@ -32,7 +32,10 @@
 define usemmldlt 'define'
 
 # Used by modules?
-define dlext 'so'
+case "$targetarch" in
+*darwin*) define dlext 'bundle' ;;
+*) define dlext 'so' ;;
+esac
 define dlsrc 'dl_dlopen.xs'
 
 # Required by lib/Config.t, and configpm may use these.
--- a/cnf/configure_tool.sh
+++ b/cnf/configure_tool.sh
@@ -88,8 +88,8 @@
 whichprog ar AR ar || die "Cannot find ar"
 whichprog nm NM nm
 whichprog ranlib RANLIB ranlib
-whichprog readelf READELF readelf || die "Cannot find readelf"
-whichprog objdump OBJDUMP objdump || die "Cannot find objdump"
+whichprog readelf READELF readelf || true
+whichprog objdump OBJDUMP objdump || true
 
 # XXX: this looks wrong, but the usemmldlt code depends on $ld being able
 # to compile try.c. What kind of moron could have written that. Oh wait.
@@ -149,15 +149,29 @@
 # File name extensions, must be set before running any compile/link tests
 define _o '.o'
 define _a '.a'
-define so 'so'
-define _exe ''
-
-# Used only for modules
-define cccdlflags '-fPIC -Wno-unused-function'
-define ccdlflags '-Wl,-E'
-
-# Misc flags setup
-predef lddlflags "-shared"	# modules
+# unpins darwin cross: Mach-O wants different shared-object naming and
+# link flags than the ELF/GNU defaults; $targetarch is known here (osname
+# is guessed later) and is *darwin* for both the buildmini and target pass.
+case "$targetarch" in
+*darwin*)
+	define so 'dylib'
+	define _exe ''
+	define cccdlflags '-fPIC -Wno-unused-function'
+	define ccdlflags ''
+	predef lddlflags "-bundle -undefined dynamic_lookup"
+	;;
+*)
+	define so 'so'
+	define _exe ''
+
+	# Used only for modules
+	define cccdlflags '-fPIC -Wno-unused-function'
+	define ccdlflags '-Wl,-E'
+
+	# Misc flags setup
+	predef lddlflags "-shared"	# modules
+	;;
+esac
 predef ccflags ''		# perl and modules
 predef ldflags ''		# perl only?
 predef cppflags ''		# unused?
@@ -274,6 +288,10 @@
 			define osname "midipix"
 			result "Midipix"
 			;;
+		*darwin*)
+			define osname "darwin"
+			result "Darwin"
+			;;
 		*)
 			result "no"
 			;;
